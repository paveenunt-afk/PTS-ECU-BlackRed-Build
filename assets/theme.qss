
QWidget { background-color:#090909; color:#f2f2f2; font-family:"Segoe UI"; font-size:10pt; }
QMainWindow,QMenuBar,QMenu,QStatusBar { background:#080808; color:#eee; }
QTabWidget::pane { border:1px solid #3a0b0b; background:#090909; }
QTabBar::tab { background:#141414; color:#bbb; padding:10px 18px; border:1px solid #2c1111; }
QTabBar::tab:selected { background:#2a0808; color:#fff; border-bottom:2px solid #e31b23; }
QFrame#panel,QFrame#actionPanel { background:#111; border:1px solid #3b1717; border-radius:8px; }
QFrame#heroPanel { background:rgba(10,10,10,210); border:1px solid #6a1111; border-radius:12px; }
QLabel#brandTitle { color:#ff3038; font-size:34px; font-weight:800; }
QLabel#brandSubtitle,QLabel#sectionTitle,QLabel#mapTitle { color:#ff5a5f; font-weight:700; }
QLabel#statusBadge { background:#260707; border:1px solid #d61d25; color:#fff; padding:10px; border-radius:8px; font-weight:700; }
QLabel#statusBadge[connected="true"] { background:#3a0909; color:#ff666b; }
QLabel#warningText { color:#d9a3a3; }
QLabel#valueCard,QLabel#statusStrip { background:#151010; border:1px solid #5a1717; padding:8px; border-radius:6px; }
QPushButton { background:#1b1b1b; color:#eee; border:1px solid #5b2222; border-radius:6px; padding:8px 12px; }
QPushButton:hover { background:#301010; border-color:#e31b23; }
QPushButton#primaryButton { background:#a80f16; border-color:#ff343b; font-weight:700; }
QPushButton#dangerButton { background:#c20f18; border:1px solid #ff4a50; font-weight:800; }
QPushButton:disabled { color:#666; background:#121212; border-color:#222; }
QComboBox,QLineEdit,QPlainTextEdit,QTreeWidget,QTableWidget { background:#0e0e0e; color:#eee; border:1px solid #4a1b1b; selection-background-color:#8d1117; selection-color:#fff; }
QHeaderView::section { background:#251010; color:#eee; border:1px solid #4a1b1b; padding:5px; }
/* Black/Red UI refinement - presentation only */
QToolTip { background:#160909; color:#ffffff; border:1px solid #ff3038; padding:5px; }
QScrollBar:vertical { background:#090909; width:12px; margin:0; }
QScrollBar::handle:vertical { background:#5b171b; min-height:28px; border-radius:5px; }
QScrollBar::handle:vertical:hover { background:#b5161e; }
QScrollBar:horizontal { background:#090909; height:12px; margin:0; }
QScrollBar::handle:horizontal { background:#5b171b; min-width:28px; border-radius:5px; }
QScrollBar::handle:horizontal:hover { background:#b5161e; }
QComboBox::drop-down { border:0; width:28px; }
QComboBox QAbstractItemView { background:#0d0d0d; color:#f4f4f4; selection-background-color:#a50f17; }
